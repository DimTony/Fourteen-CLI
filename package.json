{
  "name": "insighta-cli",
  "version": "1.0.0",
  "bin": {
    "insighta": "./bin/insighta"
  },
  "type": "module",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "link": "npm run build && npm link",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "dependencies": {
    "chalk": "^5",
    "cli-table3": "^0.6",
    "commander": "^12",
    "dotenv": "^17.4.2",
    "node-fetch": "^3",
    "open": "^11.0.0",
    "ora": "^8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.6.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1"
  }
}